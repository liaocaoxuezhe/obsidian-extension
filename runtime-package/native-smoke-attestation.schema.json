{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liaocaoxuezhe/obsidian-extension/runtime/native-smoke-attestation.schema.json",
  "title": "Analogy native embedding runtime Sigstore DSSE bundle",
  "$comment": "Production accepts only bundle v0.3 with Rekor dsse@0.0.1 evidence. scripts/runtime-smoke-attestation.mjs verifies DSSE, the pinned Fulcio/Rekor trusted root, SET, canonicalized body, RFC 6962 inclusion proof, signed checkpoint, trusted integrated time, exact archive subject, and the planned GitHub workflow identity.",
  "x-analogy-production-workflow-identity": "https://github.com/liaocaoxuezhe/obsidian-extension/.github/workflows/obsidian-runtime-matrix.yml@refs/heads/main",
  "type": "object",
  "additionalProperties": false,
  "required": ["mediaType", "verificationMaterial", "dsseEnvelope"],
  "properties": {
    "mediaType": { "const": "application/vnd.dev.sigstore.bundle.v0.3+json" },
    "verificationMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tlogEntries", "timestampVerificationData"],
      "properties": {
        "certificate": { "$ref": "#/$defs/certificate" },
        "x509CertificateChain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["certificates"],
          "properties": {
            "certificates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "$ref": "#/$defs/certificate" }
            }
          }
        },
        "tlogEntries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/tlogEntry" }
        },
        "timestampVerificationData": { "type": "object" }
      },
      "oneOf": [
        { "required": ["certificate"], "not": { "required": ["x509CertificateChain"] } },
        { "required": ["x509CertificateChain"], "not": { "required": ["certificate"] } }
      ]
    },
    "dsseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payloadType", "payload", "signatures"],
      "properties": {
        "payloadType": { "const": "application/vnd.in-toto+json" },
        "payload": { "$ref": "#/$defs/base64" },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sig"],
            "properties": {
              "keyid": { "type": "string" },
              "sig": { "$ref": "#/$defs/base64" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "base64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "decimal": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawBytes"],
      "properties": { "rawBytes": { "$ref": "#/$defs/base64" } }
    },
    "tlogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logIndex", "logId", "kindVersion", "integratedTime", "inclusionPromise", "inclusionProof", "canonicalizedBody"],
      "properties": {
        "logIndex": { "$ref": "#/$defs/decimal" },
        "logId": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keyId"],
          "properties": { "keyId": { "$ref": "#/$defs/base64" } }
        },
        "kindVersion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "version"],
          "properties": {
            "kind": { "const": "dsse" },
            "version": { "const": "0.0.1" }
          }
        },
        "integratedTime": { "$ref": "#/$defs/decimal" },
        "inclusionPromise": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signedEntryTimestamp"],
          "properties": { "signedEntryTimestamp": { "$ref": "#/$defs/base64" } }
        },
        "inclusionProof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logIndex", "rootHash", "treeSize", "hashes", "checkpoint"],
          "properties": {
            "logIndex": { "$ref": "#/$defs/decimal" },
            "rootHash": { "$ref": "#/$defs/base64" },
            "treeSize": { "$ref": "#/$defs/decimal" },
            "hashes": {
              "type": "array",
              "maxItems": 64,
              "items": { "$ref": "#/$defs/base64" }
            },
            "checkpoint": {
              "type": "object",
              "additionalProperties": false,
              "required": ["envelope"],
              "properties": { "envelope": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "canonicalizedBody": { "$ref": "#/$defs/base64" }
      }
    }
  }
}
