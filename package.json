{
	"name": "analogy-rag-in-your-vault",
	"version": "1.2.3",
	"description": "Obsidian plugin for local vault RAG with semantic search and MCP access.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run build:styles && node esbuild.config.mjs production",
		"build:styles": "tailwindcss -i ./tailwind.css -o ./styles.css --minify",
		"lint": "eslint main.ts src package.json",
		"typecheck": "tsc --noEmit",
		"test:public": "node test/embedding-model-behavior.test.js && node test/embedding-worker-materialization.test.js && node test/embedding-service-safety.test.js && node test/embedding-worker-lifecycle.test.js && node test/community-worker-bundle.test.js && node test/release-version.test.js && node test/release-integrity.test.js",
		"check": "npm run lint && npm run typecheck && npm run test:public && npm run build",
		"runtime:build": "node scripts/build-embedding-runtime.mjs",
		"runtime:manifest": "node scripts/generate-runtime-manifest.mjs --input dist/runtime --output src/runtime/generated-embedding-runtime-manifest.ts --base-url https://github.com/liaocaoxuezhe/obsidian-extension/releases/download/runtime-node22-v1",
		"runtime:finalize": "node scripts/finalize-runtime-artifact.mjs",
		"runtime:smoke": "node scripts/run-native-runtime-smoke.mjs",
		"runtime:compare-rebuilds": "node scripts/compare-runtime-rebuilds.mjs",
		"runtime:release:verify": "node scripts/prepare-release.mjs --runtime-only --runtime-staging dist/runtime",
		"test:runtime": "node scripts/run-runtime-tests.mjs",
		"setup:local": "node scripts/install-local-runtime.mjs",
		"release:prepare": "npm run build && node scripts/prepare-release.mjs",
		"release:prepare:development": "npm run build && node scripts/prepare-release.mjs --allow-development-runtime-fixture",
		"release:verify:local-plugin": "node scripts/verify-local-plugin-artifact.mjs release/1.2.3/community",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"rag",
		"semantic-search",
		"mcp"
	],
	"author": "liaocaoxuezhe",
	"license": "Apache-2.0",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/html-to-text": "^9.0.4",
		"@types/node": "^16.11.6",
		"@types/pubsub-js": "^1.8.6",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^14.0.0",
		"obsidian": "latest",
		"tailwindcss": "^3.4.3",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0"
	},
	"dependencies": {
		"@hookform/resolvers": "^3.9.1",
		"@huggingface/transformers": "^4.2.0",
		"@radix-ui/react-checkbox": "^1.1.3",
		"@radix-ui/react-collapsible": "^1.1.2",
		"@radix-ui/react-dialog": "^1.1.2",
		"@radix-ui/react-hover-card": "^1.1.2",
		"@radix-ui/react-label": "^2.1.1",
		"@radix-ui/react-scroll-area": "^1.2.2",
		"@radix-ui/react-separator": "^1.1.0",
		"@radix-ui/react-slot": "^1.1.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"html-to-text": "^9.0.5",
		"lucide-react": "^0.468.0",
		"markdown-to-jsx": "^7.7.1",
		"onnxruntime-node": "^1.26.0",
		"pubsub-js": "^1.9.5",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-hook-form": "^7.54.2",
		"tailwind-merge": "^2.5.5",
		"tailwindcss-animate": "^1.0.7",
		"uuid": "11.1.1",
		"zod": "^3.24.1"
	}
}
